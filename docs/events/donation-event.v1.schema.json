{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonatasEdward/notification-service/docs/events/donation-event.v1.schema.json",
  "title": "DonationEvent v1",
  "description": "Published by the Mão Amiga API on topic maoamiga.donations.v1. Message key: donation.id, so every event of a donation lands on the same partition and is consumed in order.",
  "type": "object",
  "required": ["eventId", "eventType", "occurredAt", "donation"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique per event. Consumers use it to discard redeliveries."
    },
    "eventType": {
      "type": "string",
      "description": "Consumers must ignore types they do not know, so producers can add new ones without breaking anyone.",
      "examples": ["DonationRegistered", "DonationReceived", "DonationCancelled"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "donation": {
      "type": "object",
      "required": ["id", "item", "quantity", "pointName", "donorId", "responsibleId"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "item": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quantity": { "type": "integer", "minimum": 1 },
        "pointId": { "type": "string", "format": "uuid" },
        "pointName": { "type": "string", "minLength": 1 },
        "donorId": { "type": "string", "format": "uuid" },
        "responsibleId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
